# PostgreSQL connection string (Neon in production: use the pooled connection string with ?sslmode=require)
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# Ask Grandpa (AI tutor). Leave empty to hide the chatbot.
# Set the real values in Vercel → Settings → Environment Variables, then redeploy.
GRANDPA_AI_API_URL=
GRANDPA_AI_API_KEY=
# Optional: model name, and the header that carries the key ("Authorization" sends "Bearer <key>").
GRANDPA_AI_MODEL=
GRANDPA_AI_AUTH_HEADER=Authorization
# Optional: questions per learner per day (default 40)
ASSISTANT_DAILY_LIMIT=40

# Library file uploads. On Vercel, connecting a Blob store sets BLOB_READ_WRITE_TOKEN for you.
# Without it (local development or your own server), uploads are saved in UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=.data/uploads
# Largest upload in MB (default 100)
# UPLOAD_MAX_MB=100
